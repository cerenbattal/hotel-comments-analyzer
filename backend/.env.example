# Leave both source keys empty to run with the bundled fictional demo hotel.
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=
# Required for the analysis (or use `ant auth login`).
ANTHROPIC_API_KEY=
# Optional overrides
# EXTRACTION_MODEL=claude-haiku-5-5
# SUMMARY_MODEL=claude-sonnet-5-5
# CORS_ORIGINS=http://localhost:3000
# DATABASE_URL=sqlite+aiosqlite:///./hotel.db   (docker-compose sets Postgres itself)
# DAILY_REFRESH=true            refresh scores of recently viewed hotels once a day
# DAILY_REFRESH_HOUR_UTC=3
# Request limits (0 turns one off). Per visitor IP, except the two daily caps.
# LIMIT_SEARCH_PER_MINUTE=30
# LIMIT_BUILDS_PER_HOUR=20      only new report builds count; cached reports are free
# LIMIT_ASKS_PER_HOUR=30
# LIMIT_BUILDS_PER_DAY=1000     whole server, caps the daily Claude bill
# LIMIT_ASKS_PER_DAY=3000
# TRUST_PROXY=false             set true behind a reverse proxy that sets X-Forwarded-For
